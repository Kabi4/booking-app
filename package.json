{
  "name": "booking-system",
  "version": "1.0.0",
  "description": "A slot booking system",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migration:up": "node -r ts-node/register ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.cjs",
    "migration:down": "node -r ts-node/register ./node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.cjs",
    "migration:up:prod": "node ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.cjs --env production",
    "migration:down:prod": "node ./node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.cjs --env production",
    "format": "prettier --write \"src/**/*.ts\" \"knexfile.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"knexfile.cjs\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.10",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "moment": "^2.30.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "prettier": "^3.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
